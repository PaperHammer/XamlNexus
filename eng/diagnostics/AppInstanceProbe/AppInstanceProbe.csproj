<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <WindowsAppSdkVersion Condition="'$(WindowsAppSdkVersion)' == ''">1.8.260317003</WindowsAppSdkVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WindowsAppSdkVersion)" />
    <Compile Include="../../../src/Templates/Winui3/Winui3_XamlNexus.UI/Activation/ActivationQueue.cs" Link="ActivationQueue.cs" />
    <Compile Include="../../../src/Templates/Winui3/Winui3_XamlNexus.UI/Activation/CanonicalAppLaunch.cs" Link="CanonicalAppLaunch.cs" />
    <Compile Include="../../../src/Templates/Winui3/Winui3_XamlNexus.UI/Activation/ActivationRedirector.cs" Link="ActivationRedirector.cs" />
    <Compile Include="../../../src/Templates/Winui3/Winui3_XamlNexus.UIComponent/Activation/BusinessActivationRequest.cs" Link="BusinessActivationRequest.cs" />
    <Compile Include="../../../src/Templates/Winui3/Winui3_XamlNexus.UIComponent/Activation/BusinessActivationNavigator.cs" Link="BusinessActivationNavigator.cs" />
    <Compile Include="../../../src/Templates/Winui3/Winui3_XamlNexus.UIComponent/Activation/ActivationCommandLine.cs" Link="ActivationCommandLine.cs" />
    <Compile Include="../../../src/Templates/Winui3/Winui3_XamlNexus.UIComponent/Navigation/INavigationRegistry.cs" Link="INavigationRegistry.cs" />
    <Compile Include="../../../src/Templates/Winui3/Winui3_XamlNexus.UIComponent/Navigation/NavigationRegistry.cs" Link="NavigationRegistry.cs" />
    <Compile Include="../../../src/Templates/Winui3/Winui3_XamlNexus.UIComponent/Utils/FrameworkPayload.cs" Link="FrameworkPayload.cs" />
  </ItemGroup>
</Project>
