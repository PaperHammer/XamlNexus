<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(BusinessProjectRoot)/BusinessWorkflow.Data/BusinessWorkflow.Data.csproj" />
    <ProjectReference Include="../../../src/XamlNexus.Common/XamlNexus.Common.csproj" />
    <Compile Include="$(BusinessProjectRoot)/BusinessWorkflow.MainPanel/Services/OrdersDataSource.cs" Link="Generated/OrdersDataSource.cs" />
    <Compile Include="$(BusinessProjectRoot)/BusinessWorkflow.MainPanel/Services/OrderDetailsDataSource.cs" Link="Generated/OrderDetailsDataSource.cs" />
    <Compile Include="$(BusinessProjectRoot)/BusinessWorkflow.MainPanel/Services/OrderEditorDataSource.cs" Link="Generated/OrderEditorDataSource.cs" />
    <Compile Include="$(BusinessProjectRoot)/BusinessWorkflow.MainPanel/Services/OrderDataSource.cs" Link="Generated/OrderDataSource.cs" />
    <Compile Include="$(BusinessProjectRoot)/BusinessWorkflow.MainPanel/ViewModels/OrdersViewModel.cs" Link="Generated/OrdersViewModel.cs" />
    <Compile Include="$(BusinessProjectRoot)/BusinessWorkflow.MainPanel/ViewModels/OrderDetailsViewModel.cs" Link="Generated/OrderDetailsViewModel.cs" />
    <Compile Include="$(BusinessProjectRoot)/BusinessWorkflow.MainPanel/ViewModels/OrderEditorViewModel.cs" Link="Generated/OrderEditorViewModel.cs" />
    <Compile Include="$(BusinessProjectRoot)/BusinessWorkflow.UIComponent/Activation/BusinessActivationRequest.cs" Link="Generated/BusinessActivationRequest.cs" />
    <Compile Include="$(BusinessProjectRoot)/BusinessWorkflow.UIComponent/Activation/BusinessActivationNavigator.cs" Link="Generated/BusinessActivationNavigator.cs" />
    <Compile Include="$(BusinessProjectRoot)/BusinessWorkflow.UIComponent/Activation/ActivationCommandLine.cs" Link="Generated/ActivationCommandLine.cs" />
    <Compile Include="$(BusinessProjectRoot)/BusinessWorkflow.UIComponent/Navigation/INavigationRegistry.cs" Link="Generated/INavigationRegistry.cs" />
    <Compile Include="$(BusinessProjectRoot)/BusinessWorkflow.UIComponent/Navigation/NavigationRegistry.cs" Link="Generated/NavigationRegistry.cs" />
    <Compile Include="$(BusinessProjectRoot)/BusinessWorkflow.UIComponent/Utils/FrameworkPayload.cs" Link="Generated/FrameworkPayload.cs" />
  </ItemGroup>
  <Target Name="RequireBusinessProject" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(BusinessProjectRoot)' == ''" Text="Set BusinessProjectRoot to the application generated by eng/New-BusinessWorkflow.ps1." />
  </Target>
</Project>
