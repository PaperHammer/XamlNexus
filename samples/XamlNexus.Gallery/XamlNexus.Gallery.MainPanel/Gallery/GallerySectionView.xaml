<UserControl
    x:Class="XamlNexus.Gallery.MainPanel.Gallery.GallerySectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:g="using:XamlNexus.Gallery.MainPanel.Gallery">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///XamlNexus.Gallery.MainPanel/Gallery/GalleryStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="SectionItemTemplate">
                <Button
                    Style="{StaticResource GalleryTileButton}"
                    Tag="{Binding Id}"
                    Click="Navigate_Click"
                    AutomationProperties.Name="{Binding Title}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Top">
                            <FontIcon Glyph="{Binding Glyph}" FontSize="20" Foreground="{ThemeResource GalleryAccentBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer x:Name="PageScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource PageBody}" Width="{Binding ViewportWidth, ElementName=PageScroll}">
            <StackPanel Spacing="12">
                <TextBlock x:Name="SectionTitleText" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock x:Name="SectionDescriptionText" Style="{StaticResource BodyText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="960" HorizontalAlignment="Left"/>
            </StackPanel>
            <TextBlock x:Name="BrowseTitle" Style="{StaticResource SectionTitle}"/>
            <ItemsRepeater x:Name="SectionItems" ItemTemplate="{StaticResource SectionItemTemplate}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="320" MinColumnSpacing="16" MinRowSpacing="16" MaximumRowsOrColumns="2" ItemsStretch="Fill"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</UserControl>
