<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:g="using:XamlNexus.Gallery.MainPanel.Gallery" xmlns:arc="using:XamlNexus.Gallery.UIComponent.Templates">
    <g:GalleryStrings x:Key="Strings"/>
    <g:BooleanVisibilityConverter x:Key="BoolVisibility"/>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style x:Key="PageBody" TargetType="StackPanel">
        <Setter Property="Padding" Value="36,28,36,40"/>
        <Setter Property="Spacing" Value="20"/>
        <Setter Property="MaxWidth" Value="1200"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="Section" TargetType="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Padding" Value="20"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    </Style>
</ResourceDictionary>
