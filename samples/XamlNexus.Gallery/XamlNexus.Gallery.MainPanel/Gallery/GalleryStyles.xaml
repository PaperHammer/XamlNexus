<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:g="using:XamlNexus.Gallery.MainPanel.Gallery" xmlns:arc="using:XamlNexus.Gallery.UIComponent.Templates">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="GalleryAccentBrush" Color="#80DDD4"/>
            <SolidColorBrush x:Key="GalleryCardStrokeBrush" Color="#3DFFFFFF"/>
            <LinearGradientBrush x:Key="GalleryHeroBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#162C3C" Offset="0"/><GradientStop Color="#1D4549" Offset="1"/></LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GalleryAccentBrush" Color="#006D70"/>
            <SolidColorBrush x:Key="GalleryCardStrokeBrush" Color="#30000000"/>
            <LinearGradientBrush x:Key="GalleryHeroBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E5EDF8" Offset="0"/><GradientStop Color="#D7EFEB" Offset="1"/></LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="GalleryAccentBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="GalleryCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="GalleryHeroBrush" Color="{ThemeResource SystemColorWindowColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <g:GalleryStrings x:Key="Strings"/>
    <g:BooleanVisibilityConverter x:Key="BoolVisibility"/>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="22"/>
    </Style>
    <Style x:Key="PageBody" TargetType="StackPanel">
        <Setter Property="Padding" Value="36,32,36,48"/>
        <Setter Property="Spacing" Value="24"/>
        <Setter Property="MaxWidth" Value="1440"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="Section" TargetType="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="BorderBrush" Value="{ThemeResource GalleryCardStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Padding" Value="24"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource GalleryCardStrokeBrush}"/>
    </Style>
    <Style x:Key="CompactCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="LineHeight" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level3"/>
    </Style>
    <Style x:Key="SubsectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level3"/>
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CharacterSpacing" Value="100"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource GalleryAccentBrush}"/>
    </Style>
    <Style x:Key="NoteCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    </Style>
    <Style x:Key="GalleryTileButton" TargetType="Button">
        <Setter Property="Padding" Value="24"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource GalleryCardStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
</ResourceDictionary>
