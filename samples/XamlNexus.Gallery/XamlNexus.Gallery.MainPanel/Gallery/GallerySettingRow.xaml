<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:g="using:XamlNexus.Gallery.MainPanel.Gallery" xmlns:arc="using:XamlNexus.Gallery.UIComponent.Templates" x:Class="XamlNexus.Gallery.MainPanel.Gallery.GallerySettingRow">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///XamlNexus.Gallery.MainPanel/Gallery/GalleryStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border MinHeight="90"
            Padding="20,16"
            CornerRadius="6"
            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
            BorderBrush="{ThemeResource GalleryCardStrokeBrush}"
            BorderThickness="1">
        <Grid x:Name="RowLayout" ColumnSpacing="20" RowSpacing="0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1000"/>
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="RowLayout.RowSpacing" Value="12"/>
                            <Setter Target="Editor.(Grid.Column)" Value="1"/>
                            <Setter Target="Editor.(Grid.Row)" Value="1"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="20" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="{ThemeResource ControlContentThemeFontSize}" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="{ThemeResource ControlContentThemeFontSize}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <ContentPresenter x:Name="Editor" Grid.Column="2" Content="{x:Bind EditorContent, Mode=OneWay}" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
