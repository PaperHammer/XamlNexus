<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:g="using:XamlNexus.Gallery.MainPanel.Gallery" xmlns:arc="using:XamlNexus.Gallery.UIComponent.Templates" x:Class="XamlNexus.Gallery.MainPanel.Gallery.GalleryPageHeader">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///XamlNexus.Gallery.MainPanel/Gallery/GalleryStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Spacing="16">
        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="28" AutomationProperties.HeadingLevel="Level1" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button BorderThickness="1" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" Padding="10,6" Tag="https://github.com/PaperHammer/XamlNexus/wiki" Click="Link_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="" FontSize="14"/>
                    <TextBlock Text="{Binding [Documentation], Source={StaticResource Strings}}" Style="{StaticResource BodyText}"/>
                </StackPanel>
            </Button>
            <Button BorderThickness="1" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" Padding="10,6" Tag="https://github.com/PaperHammer/XamlNexus" Click="Link_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="" FontSize="14"/>
                    <TextBlock Text="{Binding [Source], Source={StaticResource Strings}}" Style="{StaticResource BodyText}"/>
                </StackPanel>
            </Button>
        </StackPanel>
        <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource BodyText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="960" HorizontalAlignment="Left"/>
    </StackPanel>
</UserControl>
