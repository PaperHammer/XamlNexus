<UserControl
    x:Class="XamlNexus.Gallery.MainPanel.Gallery.PageTemplateShowcaseView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:g="using:XamlNexus.Gallery.MainPanel.Gallery">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///XamlNexus.Gallery.MainPanel/Gallery/GalleryStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Spacing="20">
        <StackPanel Spacing="8">
            <TextBlock Text="{Binding [PageTemplatesIntro], Source={StaticResource Strings}}" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="{Binding [PageTemplatesHelp], Source={StaticResource Strings}}" Style="{StaticResource BodyText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <SelectorBar x:Name="TemplateSelector" SelectionChanged="TemplateSelector_SelectionChanged">
            <SelectorBarItem Text="Blank" Tag="blank" IsSelected="True"/>
            <SelectorBarItem Text="List" Tag="list"/>
            <SelectorBarItem Text="Details" Tag="details"/>
            <SelectorBarItem Text="Form" Tag="form"/>
        </SelectorBar>

        <Border Style="{StaticResource Card}">
            <StackPanel Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="SelectedKind" Style="{StaticResource Eyebrow}"/>
                    <TextBlock x:Name="SelectedTitle" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="SelectedBody" Style="{StaticResource BodyText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Border Style="{StaticResource CompactCard}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding [PageTemplatePreview], Source={StaticResource Strings}}" Style="{StaticResource SubsectionTitle}"/>

                        <StackPanel x:Name="BlankPreview" Spacing="12">
                            <TextBlock Text="Workspace" FontSize="24" FontWeight="SemiBold"/>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            <TextBlock Text="{Binding [BlankPreviewBody], Source={StaticResource Strings}}" Style="{StaticResource BodyText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel x:Name="ListPreview" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="{Binding [ListTemplatePreviewBody], Source={StaticResource Strings}}" Style="{StaticResource BodyText}"/>
                            <Button Content="{Binding [OpenListExample], Source={StaticResource Strings}}" Click="OpenListExample_Click" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel x:Name="DetailsPreview" Spacing="12" Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DetailId" Header="{Binding [DetailsIdLabel], Source={StaticResource Strings}}" Text="A-1042"/>
                                <Button x:Name="LoadDetailsButton" Grid.Column="1" Content="{Binding [LoadDetails], Source={StaticResource Strings}}" Click="LoadDetails_Click" VerticalAlignment="Bottom"/>
                            </Grid>
                            <TextBlock Text="{Binding [DetailsFailureHint], Source={StaticResource Strings}}" Style="{StaticResource BodyText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ProgressBar x:Name="DetailsProgress" IsIndeterminate="True" Visibility="Collapsed"/>
                            <InfoBar x:Name="DetailsError" Severity="Error" IsClosable="False" IsOpen="False" Title="{Binding [DetailsErrorTitle], Source={StaticResource Strings}}" Message="{Binding [DetailsErrorMessage], Source={StaticResource Strings}}">
                                <InfoBar.ActionButton>
                                    <Button Content="{Binding [Retry], Source={StaticResource Strings}}" Click="LoadDetails_Click"/>
                                </InfoBar.ActionButton>
                            </InfoBar>
                            <Border x:Name="DetailsResult" Padding="16" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource GalleryCardStrokeBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Visibility="Collapsed">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="DetailsResultTitle" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DetailsResultDescription" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DetailsResultId" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="FormPreview" Spacing="12" Visibility="Collapsed">
                            <TextBox x:Name="FormName" Header="{Binding [FormNameLabel], Source={StaticResource Strings}}" Text="Northwind" TextChanged="FormField_TextChanged"/>
                            <TextBlock x:Name="FormNameError" Text="{Binding [FormNameRequired], Source={StaticResource Strings}}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed"/>
                            <TextBox x:Name="FormDescription" Header="{Binding [FormDescriptionLabel], Source={StaticResource Strings}}" Text="Desktop customer workspace" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" TextChanged="FormField_TextChanged"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SaveFormButton" Content="{Binding [Save], Source={StaticResource Strings}}" Click="SaveForm_Click"/>
                                <Button x:Name="ResetFormButton" Content="{Binding [Reset], Source={StaticResource Strings}}" Click="ResetForm_Click"/>
                                <TextBlock x:Name="FormState" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding [GeneratedFiles], Source={StaticResource Strings}}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SelectedFiles" Grid.Column="1" Style="{StaticResource BodyText}"/>
                    <TextBlock Grid.Row="1" Text="{Binding [RuntimeFlow], Source={StaticResource Strings}}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SelectedFlow" Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyText}"/>
                </Grid>

                <g:GalleryCodeView x:Name="TemplateCommand"/>
            </StackPanel>
        </Border>

        <g:GalleryCodeView x:Name="BlankSource"/>
        <g:GallerySourceBrowser x:Name="TemplateSource" Visibility="Collapsed"/>
        <Border Style="{StaticResource NoteCard}">
            <TextBlock Text="{Binding [PageTemplateBoundary], Source={StaticResource Strings}}" Style="{StaticResource BodyText}"/>
        </Border>
    </StackPanel>
</UserControl>
