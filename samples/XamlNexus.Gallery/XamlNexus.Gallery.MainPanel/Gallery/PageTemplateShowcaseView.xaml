<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:g="using:XamlNexus.Gallery.MainPanel.Gallery" xmlns:arc="using:XamlNexus.Gallery.UIComponent.Templates" x:Class="XamlNexus.Gallery.MainPanel.Gallery.PageTemplateShowcaseView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///XamlNexus.Gallery.MainPanel/Gallery/GalleryStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Spacing="24">
        <SelectorBar x:Name="TemplateSelector" SelectionChanged="TemplateSelector_SelectionChanged">
            <SelectorBarItem Text="{Binding [TemplateList], Source={StaticResource Strings}}" Tag="list" IsSelected="True"/>
            <SelectorBarItem Text="{Binding [TemplateDetails], Source={StaticResource Strings}}" Tag="details"/>
            <SelectorBarItem Text="{Binding [TemplateForm], Source={StaticResource Strings}}" Tag="form"/>
            <SelectorBarItem Text="{Binding [TemplateBlank], Source={StaticResource Strings}}" Tag="blank"/>
        </SelectorBar>
        <StackPanel Spacing="6">
            <TextBlock x:Name="SelectedTitle" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="SelectedBody" Style="{StaticResource BodyText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <Border Style="{StaticResource Card}" Background="{ThemeResource GalleryMutedSurfaceBrush}">
            <StackPanel Spacing="16">
                <TextBlock Text="{Binding [BusinessWorkflowHint], Source={StaticResource Strings}}" Style="{StaticResource BodyText}"/>
                <StackPanel x:Name="ListPreview" Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="{Binding [SearchItems], Source={StaticResource Strings}}" AutomationProperties.Name="{Binding [SearchItems], Source={StaticResource Strings}}" Text="{x:Bind ListModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="{Binding [Refresh], Source={StaticResource Strings}}" Command="{x:Bind ListModel.RefreshCommand}"/>
                    </Grid>
                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ToVisibility(ListModel.IsBusy), Mode=OneWay}"/>
                    <InfoBar Severity="Error" IsClosable="False" IsOpen="{x:Bind ListModel.HasError, Mode=OneWay}" Message="{x:Bind ListModel.ErrorMessage, Mode=OneWay}"/>
                    <ListView ItemsSource="{x:Bind ListModel.Items}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Record_Click" AutomationProperties.Name="{Binding [BusinessRecords], Source={StaticResource Strings}}" MaxHeight="260">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="4" Padding="8,10">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="{Binding [BusinessNoRecords], Source={StaticResource Strings}}" Visibility="{x:Bind ToVisibility(ListModel.IsEmpty), Mode=OneWay}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="{Binding [BusinessNewRecord], Source={StaticResource Strings}}" Click="NewRecord_Click" Style="{StaticResource AccentButtonStyle}"/><Button Content="{Binding [OpenListExample], Source={StaticResource Strings}}" Click="OpenListExample_Click"/></StackPanel>
                </StackPanel>
                <StackPanel x:Name="DetailsPreview" Spacing="12" Visibility="Collapsed">
                    <TextBox x:Name="DetailId" Header="{Binding [DetailsIdLabel], Source={StaticResource Strings}}" IsReadOnly="True"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="EditRecordButton" Content="{Binding [BusinessEditRecord], Source={StaticResource Strings}}" Click="EditRecord_Click" Style="{StaticResource AccentButtonStyle}"/>
                        <Button Content="{Binding [BusinessBackToList], Source={StaticResource Strings}}" Click="BackToList_Click"/>
                        <Button x:Name="FailReadButton" Content="{Binding [BusinessFailRead], Source={StaticResource Strings}}" Click="FailRead_Click"/>
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ToVisibility(DetailsModel.IsBusy), Mode=OneWay}"/>
                    <InfoBar Severity="Error" IsClosable="False" IsOpen="{x:Bind DetailsModel.HasError, Mode=OneWay}" Message="{x:Bind DetailsModel.ErrorMessage, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button Content="{Binding [Retry], Source={StaticResource Strings}}" Command="{x:Bind DetailsModel.RetryCommand}"/>
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <StackPanel Spacing="6" Visibility="{x:Bind ToVisibility(DetailsModel.HasItem), Mode=OneWay}">
                        <TextBlock Text="{x:Bind DetailsModel.Title, Mode=OneWay}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{x:Bind DetailsModel.Description, Mode=OneWay}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind DetailsModel.Identifier, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="FormPreview" Spacing="12" Visibility="Collapsed">
                    <TextBox Header="{Binding [FormNameLabel], Source={StaticResource Strings}}" Text="{x:Bind FormModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind FormModel.CanEdit, Mode=OneWay}"/>
                    <TextBlock Text="{Binding [FormNameRequired], Source={StaticResource Strings}}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind ToVisibility(FormModel.HasNameError), Mode=OneWay}"/>
                    <TextBox Header="{Binding [FormDescriptionLabel], Source={StaticResource Strings}}" Text="{x:Bind FormModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind FormModel.CanEdit, Mode=OneWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88"/>
                    <InfoBar Severity="Error" IsClosable="False" IsOpen="{x:Bind FormModel.HasError, Mode=OneWay}" Message="{x:Bind FormModel.ErrorMessage, Mode=OneWay}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Style="{StaticResource AccentButtonStyle}" Content="{Binding [Save], Source={StaticResource Strings}}" Command="{x:Bind FormModel.SaveCommand}"/>
                        <Button Content="{Binding [Reset], Source={StaticResource Strings}}" Command="{x:Bind FormModel.ResetCommand}"/>
                        <TextBlock x:Name="FormState" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="BackToListButton" Content="{Binding [BusinessBackToList], Source={StaticResource Strings}}" Click="BackToList_Click" Visibility="{x:Bind ToVisibility(FormModel.CanEdit), Mode=OneWay}" HorizontalAlignment="Left"/>
                <StackPanel x:Name="BlankPreview" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Workspace" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding [BlankPreviewBody], Source={StaticResource Strings}}" Style="{StaticResource BodyText}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <StackPanel Spacing="14">
                <TextBlock Text="{Binding [ActivationDemoTitle], Source={StaticResource Strings}}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding [ActivationDemoBody], Source={StaticResource Strings}}" Style="{StaticResource BodyText}"/>
                <TextBlock Text="{Binding [ActivationPreviewBoundary], Source={StaticResource Strings}}" Style="{StaticResource BodyText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="ActivationRoute" Header="{Binding [ActivationRouteLabel], Source={StaticResource Strings}}" Text="OrderEditor"/>
                <TextBox x:Name="ActivationData" Header="{Binding [ActivationDataLabel], Source={StaticResource Strings}}" Text="{}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="180" FontFamily="Consolas"/>
                <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3">
                    <Button x:Name="ActivationDetailsButton" Tag="OrderDetails" Click="ActivationSelectedRecord_Click" Content="{Binding [ActivationSelectedDetails], Source={StaticResource Strings}}" Margin="0,0,12,8"/>
                    <Button x:Name="ActivationEditorButton" Tag="OrderEditor" Click="ActivationSelectedRecord_Click" Content="{Binding [ActivationSelectedEditor], Source={StaticResource Strings}}" Margin="0,0,12,8"/>
                    <Button x:Name="ActivationApplyButton" Click="ActivationApply_Click" Content="{Binding [ActivationApply], Source={StaticResource Strings}}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,0,8"/>
                </VariableSizedWrapGrid>
                <InfoBar x:Name="ActivationFeedback" IsOpen="False" IsClosable="False"/>
                <TextBlock Text="{Binding [ActivationDemoCheck], Source={StaticResource Strings}}" Style="{StaticResource BodyText}"/>
                <Expander Header="{Binding [ActivationCommandTitle], Source={StaticResource Strings}}">
                    <g:GalleryCodeView x:Name="ActivationCommand"/>
                </Expander>
            </StackPanel>
        </Border>
        <StackPanel Spacing="12">
            <TextBlock Text="{Binding [UseInProject], Source={StaticResource Strings}}" Style="{StaticResource SectionTitle}"/>
            <g:GalleryCodeView x:Name="TemplateCommand"/>
            <TextBlock Text="{Binding [PageTemplateBoundary], Source={StaticResource Strings}}" Style="{StaticResource BodyText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <g:GallerySourceBrowser Kind="Business"/>
        <Expander Header="{Binding [GeneratedFiles], Source={StaticResource Strings}}" Style="{StaticResource Section}">
            <StackPanel Spacing="16">
                <TextBlock x:Name="SelectedFiles" FontFamily="Consolas" TextWrapping="Wrap"/>
                <TextBlock x:Name="SelectedFlow" Style="{StaticResource BodyText}"/>
                <g:GalleryCodeView x:Name="BlankSource"/>
                <g:GallerySourceBrowser x:Name="TemplateSource"/>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
