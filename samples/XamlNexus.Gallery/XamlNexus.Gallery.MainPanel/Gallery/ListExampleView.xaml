<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:g="using:XamlNexus.Gallery.MainPanel.Gallery" xmlns:arc="using:XamlNexus.Gallery.UIComponent.Templates" x:Class="XamlNexus.Gallery.MainPanel.Gallery.ListExampleView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///XamlNexus.Gallery.MainPanel/Gallery/GalleryStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer x:Name="PageScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Left">
        <StackPanel Style="{StaticResource PageBody}" Width="{Binding ViewportWidth, ElementName=PageScroll}">
            <g:GalleryPageHeader x:Name="Header" Description="{Binding [ListDescription], Source={StaticResource Strings}}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding [SampleTryTitle], Source={StaticResource Strings}}" Style="{StaticResource Eyebrow}"/>
                    <TextBlock x:Name="ExampleTitle" Text="{Binding [ListExampleTitle], Source={StaticResource Strings}}" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="TryDescription" Text="{Binding [ListTrySteps], Source={StaticResource Strings}}" Style="{StaticResource BodyText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Grid ColumnSpacing="24" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition x:Name="OptionsColumn" Width="210"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="Wide">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="1100"/>
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState x:Name="Narrow">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0"/>
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="OptionsColumn.Width" Value="0"/>
                                        <Setter Target="Options.(Grid.Column)" Value="0"/>
                                        <Setter Target="Options.(Grid.Row)" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <StackPanel Spacing="8">
                            <TextBox PlaceholderText="{Binding [SearchItems], Source={StaticResource Strings}}" AutomationProperties.Name="{Binding [SearchItems], Source={StaticResource Strings}}" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <ProgressRing Width="24" Height="24" HorizontalAlignment="Left" IsActive="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
                            <InfoBar Title="{Binding [RequestFailed], Source={StaticResource Strings}}" IsClosable="False" Severity="Error" IsOpen="{Binding HasError}" Message="{Binding ErrorMessage}"/>
                            <ListView ItemsSource="{Binding Items}" SelectionMode="None" MaxHeight="260">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="8,10" Spacing="4">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock Text="{Binding [NoMatches], Source={StaticResource Strings}}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"/>
                        </StackPanel>
                        <StackPanel x:Name="Options" Grid.Column="1" Spacing="8">
                            <TextBlock x:Name="OptionsHeading" Text="{Binding [Options], Source={StaticResource Strings}}" Style="{StaticResource BodyText}"/>
                            <Button Style="{StaticResource AccentButtonStyle}" Content="{Binding [Refresh], Source={StaticResource Strings}}" Command="{Binding RefreshCommand}"/>
                            <CheckBox x:Name="Slow" Content="{Binding [SlowRequest], Source={StaticResource Strings}}" Click="Slow_Click"/>
                            <CheckBox x:Name="Fail" Content="{Binding [SimulateFailure], Source={StaticResource Strings}}" Click="Fail_Click"/>
                        </StackPanel>
                    </Grid>
                    <Expander Header="{Binding [UseInProject], Source={StaticResource Strings}}" Style="{StaticResource Section}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding [ListScopeHelp], Source={StaticResource Strings}}" Style="{StaticResource BodyText}"/>
                            <g:GalleryIntegrationView x:Name="Integration"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding [ListBehaviorTitle], Source={StaticResource Strings}}" Style="{StaticResource SectionTitle}" FontSize="18" LineHeight="26"/>
            <Border Style="{StaticResource CompactCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE895;" FontSize="18" Foreground="{ThemeResource GalleryAccentBrush}" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="{Binding [ListRequestFlowTitle], Source={StaticResource Strings}}" Style="{StaticResource CardTitle}" FontSize="14" LineHeight="22"/>
                        <TextBlock Text="{Binding [ListRequestFlowBody], Source={StaticResource Strings}}" Style="{StaticResource BodyText}"/>
                        <TextBlock Text="{Binding [ListRequestFlowCode], Source={StaticResource Strings}}" FontFamily="Consolas" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource CompactCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource GalleryAccentBrush}" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="{Binding [ListUiStateTitle], Source={StaticResource Strings}}" Style="{StaticResource CardTitle}" FontSize="14" LineHeight="22"/>
                        <TextBlock Text="{Binding [ListUiStateBody], Source={StaticResource Strings}}" Style="{StaticResource BodyText}"/>
                        <TextBlock Text="{Binding [ListUiStateCode], Source={StaticResource Strings}}" FontFamily="Consolas" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource CompactCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE711;" FontSize="18" Foreground="{ThemeResource GalleryAccentBrush}" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="{Binding [ListCancellationTitle], Source={StaticResource Strings}}" Style="{StaticResource CardTitle}" FontSize="14" LineHeight="22"/>
                        <TextBlock Text="{Binding [ListCancellationBody], Source={StaticResource Strings}}" Style="{StaticResource BodyText}"/>
                        <TextBlock Text="{Binding [ListCancellationCode], Source={StaticResource Strings}}" FontFamily="Consolas" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <g:GallerySourceBrowser Kind="Template"/>
            <g:GallerySourceBrowser Kind="Demo"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
