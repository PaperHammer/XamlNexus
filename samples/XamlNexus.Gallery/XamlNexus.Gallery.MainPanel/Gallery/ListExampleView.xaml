<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:g="using:XamlNexus.Gallery.MainPanel.Gallery" xmlns:arc="using:XamlNexus.Gallery.UIComponent.Templates" x:Class="XamlNexus.Gallery.MainPanel.Gallery.ListExampleView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///XamlNexus.Gallery.MainPanel/Gallery/GalleryStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer x:Name="PageScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Left">
        <StackPanel Style="{StaticResource PageBody}" Width="{Binding ViewportWidth, ElementName=PageScroll}">
            <g:GalleryPageHeader x:Name="Header" Description="{Binding [ListDescription], Source={StaticResource Strings}}"/>
            <TextBlock x:Name="ExampleTitle" Text="{Binding [ListExampleTitle], Source={StaticResource Strings}}" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
            <StackPanel>
                <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="8,8,0,0" Padding="24">
                    <Grid ColumnSpacing="24" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition x:Name="OptionsColumn" Width="210"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="Wide">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="1100"/>
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState x:Name="Narrow">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0"/>
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="OptionsColumn.Width" Value="0"/>
                                        <Setter Target="Options.(Grid.Column)" Value="0"/>
                                        <Setter Target="Options.(Grid.Row)" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <StackPanel Spacing="8">
                            <TextBox PlaceholderText="{Binding [SearchItems], Source={StaticResource Strings}}" AutomationProperties.Name="{Binding [SearchItems], Source={StaticResource Strings}}" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <ProgressRing Width="24" Height="24" HorizontalAlignment="Left" IsActive="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
                            <InfoBar Title="{Binding [RequestFailed], Source={StaticResource Strings}}" IsClosable="False" Severity="Error" IsOpen="{Binding HasError}" Message="{Binding ErrorMessage}"/>
                            <ListView ItemsSource="{Binding Items}" SelectionMode="None" MaxHeight="260">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="8,10" Spacing="4">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock Text="{Binding [NoMatches], Source={StaticResource Strings}}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"/>
                        </StackPanel>
                        <StackPanel x:Name="Options" Grid.Column="1" Spacing="8">
                            <TextBlock x:Name="OptionsHeading" Text="{Binding [Options], Source={StaticResource Strings}}" Style="{StaticResource BodyText}"/>
                            <Button Content="{Binding [Refresh], Source={StaticResource Strings}}" Command="{Binding RefreshCommand}"/>
                            <CheckBox x:Name="Slow" Content="{Binding [SlowRequest], Source={StaticResource Strings}}" Click="Slow_Click"/>
                            <CheckBox x:Name="Fail" Content="{Binding [SimulateFailure], Source={StaticResource Strings}}" Click="Fail_Click"/>
                            <TextBlock x:Name="InstanceLabel" FontSize="12" Opacity="0.65"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <g:GallerySourceBrowser Kind="Template"/>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding [TryIt], Source={StaticResource Strings}}" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                <TextBlock x:Name="TryDescription" Style="{StaticResource BodyText}" Opacity="0.75"/>
            </StackPanel>
            <Expander x:Name="LifetimeSection" Header="{Binding [CompareLifetimes], Source={StaticResource Strings}}" Style="{StaticResource Section}">
                <g:GalleryLifetimeView/>
            </Expander>
            <Expander Header="{Binding [UseInProject], Source={StaticResource Strings}}" Style="{StaticResource Section}">
                <g:GalleryIntegrationView x:Name="Integration"/>
            </Expander>
            <g:GallerySourceBrowser Kind="Demo"/>
            <StackPanel x:Name="PersistenceTip" Spacing="4">
                <TextBlock Text="{Binding [NotPersistence], Source={StaticResource Strings}}" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding [PersistenceHelp], Source={StaticResource Strings}}" Style="{StaticResource BodyText}" Opacity="0.75"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
