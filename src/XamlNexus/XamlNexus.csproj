<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>		
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>xamlnexus</ToolCommandName>
		<PackageId>XamlNexus</PackageId>
		<Version>1.0.4</Version>
		<AssemblyVersion>1.0.4</AssemblyVersion>
		<PackageVersion>1.0.4</PackageVersion>
		<Authors>PaperHammer</Authors>
		<PackageProjectUrl>https://github.com/PaperHammer/XamlNexus</PackageProjectUrl>
		<PackageIcon>XamlNexus_128x128.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/PaperHammer/XamlNexus</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Description>Quickly generate Windows desktop application prototypes using the .NET CLI scaffolding tool, based on common XAML frameworks such as WPF and WinUI 3.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<NoDefaultExcludes>true</NoDefaultExcludes>
		<NoWarn>$(NoWarn);NU5111</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Include="./README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup Condition="'$(GalleryManifestPath)' != ''">
		<None Include="$(GalleryManifestPath)" Pack="true" PackagePath="tools/$(TargetFramework)/any/gallery-manifest.json" />
	</ItemGroup>
	<Target Name="RequireGalleryManifest" BeforeTargets="GenerateNuspec" Condition="'$(RequireGalleryManifest)' == 'true'">
		<Error Condition="'$(GalleryManifestPath)' == '' Or !Exists('$(GalleryManifestPath)')" Text="Official packages require a generated Gallery manifest." />
	</Target>

	<ItemGroup>
		<Content Include="..\Templates\**\*" Exclude="..\Templates\**\bin\**;..\Templates\**\obj\**;..\Templates\**\.vs\**;..\Templates\**\Plugins\**">
			<Pack>true</Pack>
			<PackagePath>tools/$(TargetFramework)/any/Templates/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\XamlNexus.Generator.Winui3App\XamlNexus.Generator.Winui3App.csproj" />
		<ProjectReference Include="..\XamlNexus.Generator.Winui3_Wpf_App\XamlNexus.Generator.Winui3_Wpf_App.csproj" />
		<ProjectReference Include="..\XamlNexus.Recipes.BuiltIn\XamlNexus.Recipes.BuiltIn.csproj" />
		<ProjectReference Include="..\XamlNexus.Tooling\XamlNexus.Tooling.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="XamlNexus_128x128.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<Target Name="CopyTemplates" AfterTargets="Build">
		<RemoveDir Directories="$(OutDir)Templates" />
		
		<ItemGroup>
			<TemplateFiles Include="$(MSBuildProjectDirectory)\..\Templates\**\*"
			               Exclude="$(MSBuildProjectDirectory)\..\Templates\**\bin\**;
			                        $(MSBuildProjectDirectory)\..\Templates\**\obj\**;
			                        $(MSBuildProjectDirectory)\..\Templates\**\.vs\**;
			                        $(MSBuildProjectDirectory)\..\Templates\**\Plugins\**" />
		</ItemGroup>

		<Copy SourceFiles="@(TemplateFiles)" DestinationFolder="$(OutDir)Templates\%(RecursiveDir)" />
	</Target>
</Project>
