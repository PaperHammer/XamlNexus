<?xml version="1.0" encoding="utf-8"?>
<arc:ArcWindow
    x:Class="Winui3_XamlNexus.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winui3_XamlNexus.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:arc="using:Winui3_XamlNexus.UIComponent.Templates"
    xmlns:navi="using:Winui3_XamlNexus.UIComponent.Navigation"
    xmlns:styles="using:Winui3_XamlNexus.UIComponent.Styles"
    xmlns:l="using:WinUI3Localizer"
    mc:Ignorable="d"
    Width="1460" Height="900"
    MinHeight="648" MinWidth="800"
    Title="Winui3_XamlNexus.UI">

    <arc:ArcWindowHost x:Name="MainHost">
        <Grid x:Name="MainGrid">
            <navi:ArcNavigationView x:Name="NavigationViewControl"
                CompactPaneLength="64"
                IsBackButtonVisible="Visible"
                IsBackEnabled="False"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                IsTabStop="False"
                SelectionChanged="OnNavigationViewSelectionChanged">

                <navi:ArcNavigationView.PaneFooter>
                    <StackPanel x:Name="FooterStackPanel"
                        Orientation="Vertical"
                        HorizontalAlignment="Stretch"
                        Margin="-2 0 0 0">
                        <Button x:Name="LightAndDarkButton"
                            Style="{StaticResource ArcNavigationButtonNormalStyle}"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            Width="Auto"
                            HorizontalAlignment="Stretch"
                            Click="LightAndDarkButton_Click">
                            <styles:ArcImageIcon Width="28" ResourceKey="{x:Bind PropertyHost.ThemeIconKey, Mode=OneWay}"/>
                        </Button>
                    </StackPanel>
                </navi:ArcNavigationView.PaneFooter>


                <navi:ArcNavigationContentView x:Name="NaviContent" InfobarMessages="{x:Bind InfobarMessages}"/>
            </navi:ArcNavigationView>
        </Grid>
    </arc:ArcWindowHost>
</arc:ArcWindow>
