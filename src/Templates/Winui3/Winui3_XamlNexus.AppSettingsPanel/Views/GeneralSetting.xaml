<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winui3_XamlNexus.AppSettingsPanel.Views.GeneralSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winui3_XamlNexus.AppSettingsPanel.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:l="using:WinUI3Localizer"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollView>
        <StackPanel Margin="15 0 15 15" Orientation="Vertical">

            <StackPanel x:Name="Version" Orientation="Vertical"
                Visibility="{x:Bind _viewModel.HasAppUpdater, Converter={StaticResource VisibilityByValueConverter}}">
                <TextBlock l:Uids.Uid="Settings_General_Text_Version" x:Name="VersionHeader"
                    Margin="0 10"

                    FontWeight="Bold"/>

                <Grid x:Name="VersionContent"
                    Height="90"
                    Margin="0 5"
                    Padding="20 0"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Margin="0 0 20 0" Glyph="&#xE117;"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{x:Bind _viewModel.AppVersionText}" FontSize="16"/>
                        <TextBlock
                            Grid.Row="1"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind _viewModel.Version_LastCheckDate, Mode=OneWay}"/>
                    </Grid>

                    <Grid Grid.Column="2" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <ProgressRing x:Name="UpdateProgressRing"
                            IsActive="{x:Bind _viewModel.IsUpdateRingActive, Mode=OneWay}"
                            Margin="40 0"
                            Background="Transparent"/>
                        <Button l:Uids.Uid="Settings_General_Version_UpdateCheck" x:Name="VersionCheckUpdate"
                            Grid.Column="1"
                            Width="200"
                            HorizontalAlignment="Stretch"

                            IsEnabled="{x:Bind _viewModel.IsUpdateBtnEnable, Mode=OneWay}"
                            Command="{x:Bind _viewModel.CheckUpdateCommand}"
                            Visibility="{x:Bind _viewModel.IsWinStore, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!}"/>
                    </Grid>
                </Grid>

                <InfoBar l:Uids.Uid="Settings_General_Version_FindNew" x:Name="InfoBarFindNew"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Visibility="{x:Bind _viewModel.CurrentVersionState, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=FindNew}"

                    Message="{x:Bind _viewModel.Version, Mode=OneWay}" >
                    <InfoBar.Content>
                        <Grid Padding="10 0" Margin="0 0 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Button l:Uids.Uid="Settings_General_Version_DownloadStart"

                                IsEnabled="{x:Bind _viewModel.IsUpdateBtnEnable, Mode=OneWay}"
                                Width="100"
                                Command="{x:Bind _viewModel.StartDownloadComand}"/>

                            <HyperlinkButton l:Uids.Uid="Settings_General_Version_SeeNews"
                                Grid.Column="1"

                                HorizontalAlignment="Right"
                                NavigateUri="https://github.com/PaperHammer/Winui3_XamlNexus/releases"/>
                        </Grid>
                    </InfoBar.Content>
                </InfoBar>

                <InfoBar l:Uids.Uid="Settings_General_Version_DownloadingTitle"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Visibility="{x:Bind _viewModel.CurrentVersionState, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=Downloading}"
                    >
                    <InfoBar.Content>
                        <Grid Padding="10 0" Margin="0 0 0 10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <ProgressBar
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{x:Bind _viewModel.DownloadProgress, Mode=OneWay}"
                                    IsIndeterminate="{x:Bind _viewModel.IsDownloadProgressIndeterminate, Mode=OneWay}"/>
                                <TextBlock Text="{x:Bind _viewModel.DownloadProgressText, Mode=OneWay}"/>
                            </StackPanel>
                            <Button l:Uids.Uid="Settings_General_Version_DownloadCancel"
                                Grid.Column="1"

                                Command="{x:Bind _viewModel.CancelDownloadCommand}"/>
                        </Grid>
                    </InfoBar.Content>
                </InfoBar>

                <InfoBar l:Uids.Uid="Settings_General_Version_DownloadFailedTitle"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Error"
                    Visibility="{x:Bind _viewModel.CurrentVersionState, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=DownloadFailed}"

                    />

                <InfoBar l:Uids.Uid="Settings_General_Version_UpdateErr" x:Name="InfoBarNetErr"
                    Visibility="{x:Bind _viewModel.CurrentVersionState, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=UpdateErr}"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Error"
                    />

                <InfoBar l:Uids.Uid="Settings_General_Version_UptoNewest" x:Name="InfoBarUptoNewest"
                    Visibility="{x:Bind _viewModel.CurrentVersionState, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=UptoNewest}"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Success"
                     >
                </InfoBar>
            </StackPanel>

            <StackPanel x:Name="AppearanceAndAction"
                Margin="0 20 0 0"
                Orientation="Vertical">

                <TextBlock l:Uids.Uid="Settings_General_Text_AppearanceAndAction" x:Name="AppearanceAndActionHeader"
                    Margin="0 10"

                    FontWeight="Bold"/>

                <Grid x:Name="AutoStart"
                    Height="90"
                    Margin="0 5"
                    Padding="20 0"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Margin="0 0 20 0" Glyph="&#xE768;"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock l:Uids.Uid="Settings_General_AppearanceAndAction_AutoStart" />
                    </Grid>

                    <ToggleButton x:Name="AutoStartToggle"
                        IsEnabled="{x:Bind _viewModel.IsAutoStartChangeEnabled, Mode=OneWay}"
                        Grid.Column="2"
                        Width="200"
                        Content="{x:Bind _viewModel.AutoStartStatu, Mode=OneWay}"
                        IsChecked="{x:Bind _viewModel.IsAutoStart, Mode=TwoWay}"/>
                </Grid>

                <Grid x:Name="SystemBackdrop"
                    Height="90"
                    Margin="0 5"
                    Padding="20 0"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Margin="0 0 20 0" Glyph="&#xE727;"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock l:Uids.Uid="Settings_General_AppearanceAndAction_AppSystemBackdrop" />
                        <TextBlock l:Uids.Uid="Settings_General_AppearanceAndAction_AppSystemBackdropExplain"
                            Grid.Row="1"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            />
                        <StackPanel
                            Grid.Row="2"
                            Margin="0"
                            Padding="0"
                            Orientation="Horizontal">
                            <HyperlinkButton l:Uids.Uid="Settings_General_AppearanceAndAction_AppSystemBackdrop_Mica_Hyperlink"
                                Margin="0"
                                Padding="0"

                                NavigateUri="https://learn.microsoft.com/en-us/windows/apps/design/style/mica"/>
                            <HyperlinkButton l:Uids.Uid="Settings_General_AppearanceAndAction_AppSystemBackdrop_Acrylic_Hyperlink"
                                Margin="15 0 0 0"
                                Padding="0"

                                NavigateUri="https://learn.microsoft.com/en-us/windows/apps/design/style/acrylic"/>
                        </StackPanel>
                    </Grid>

                    <ComboBox x:Name="AppSystemBackdropCombo"
                        IsEnabled="{x:Bind _viewModel.IsBackdropChangeEnabled, Mode=OneWay}"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind _viewModel.SystemBackdrops, Mode=OneWay}"
                        SelectedIndex="{x:Bind _viewModel.SeletedSystemBackdropIndx, Mode=TwoWay}"
                        Width="200" />
                </Grid>

                <Grid x:Name="LanguageSetting"
                    Height="90"
                    Margin="0 5"
                    Padding="20 0"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Margin="0 0 20 0" Glyph="&#xF2B7;"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock l:Uids.Uid="Settings_General_AppearanceAndAction_AppLanguage" />
                        <TextBlock l:Uids.Uid="Settings_General_AppearanceAndAction_AppLanguageExplain"
                            Grid.Row="1"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            />
                    </Grid>

                    <ComboBox x:Name="AppLanguageCombo"
                        IsEnabled="{x:Bind _viewModel.IsLanguageChangeEnabled, Mode=OneWay}"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind _viewModel.Languages}"
                        SelectedItem="{x:Bind _viewModel.SelectedLanguage, Mode=TwoWay}"
                        DisplayMemberPath="Language"
                        SelectedValuePath="Language"
                        Width="200" />
                </Grid>

                <StackPanel x:Name="TraySettings" Visibility="Collapsed">
                    <Grid Height="90" Margin="0 5" Padding="20 0"
                        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Margin="0 0 20 0" Glyph="&#xF78A;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0 0 20 0">
                            <TextBlock x:Name="TraySettingsHeader" />
                            <TextBlock x:Name="TraySettingsDescription" TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="TrayCloseBehavior" Grid.Column="2"
                            Width="200" VerticalAlignment="Center"
                            SelectionChanged="TrayCloseBehavior_SelectionChanged" />
                    </Grid>
                    <InfoBar x:Name="TraySettingsError" Severity="Error" IsOpen="False" />
                </StackPanel>

                <Expander x:Name="FileStorage"
                    Margin="0 5"
                    Padding="20 0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Margin="0 0 20 0" Glyph="&#xE8B7;"/>

                            <Grid Margin="0 23" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock l:Uids.Uid="Settings_General_AppearanceAndAction_AppFileStorage" />
                                <TextBlock TextWrapping="Wrap" l:Uids.Uid="Settings_General_AppearanceAndAction_AppFileStorageExplain"
                                    Grid.Row="1"

                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </Grid>
                        </Grid>
                    </Expander.Header>
                    <Expander.Content>
                        <StackPanel Orientation="Vertical" Margin="35 0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="FileStorageButton"
                                    Content="{x:Bind _viewModel.SaveDir, Mode=OneWay}"
                                    IsEnabled="{x:Bind _viewModel.IsDirectoryChangeEnable, Mode=OneWay}"
                                    MaxWidth="700"
                                    HorizontalContentAlignment="Left"
                                    Command="{x:Bind _viewModel.ChangeFileStorageCommand}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip l:Uids.Uid="Settings_General_AppearanceAndAction_AppFileStorage_ModifyTooltip" Placement="Mouse"  Visibility="Visible" />
                                    </ToolTipService.ToolTip>
                                </Button>

                                <Button x:Name="OpenFileStorageButton"
                                    Grid.Column="1"
                                    Margin="10 0"
                                    Command="{x:Bind _viewModel.OpenFileStorageCommand}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip l:Uids.Uid="Settings_General_AppearanceAndAction_AppFileStorage_OpenTooltip" Placement="Mouse"  Visibility="Visible" />
                                    </ToolTipService.ToolTip>
                                    <Button.Content>
                                        <FontIcon Glyph="&#xE838;" />
                                    </Button.Content>
                                </Button>

                                <ProgressRing
                                    Width="20"
                                    Height="20"
                                    Grid.Column="2"
                                    IsActive="{x:Bind _viewModel.DirectoryChangeOngoing, Mode=OneWay}"/>
                            </Grid>
                        </StackPanel>
                    </Expander.Content>
                </Expander>
            </StackPanel>
        </StackPanel>
    </ScrollView>
</Page>
