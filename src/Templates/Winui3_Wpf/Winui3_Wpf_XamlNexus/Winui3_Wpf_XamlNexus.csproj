<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
		<ApplicationIcon>xamlnexus.ico</ApplicationIcon>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- The generated resource class follows the legacy lowercase lang.resx filename. -->
		<NoWarn>$(NoWarn);CS8981</NoWarn>
		<!-- Plugins are runtime artifacts, not WPF source files. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\Plugins\**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
	  <Content Include="xamlnexus.ico">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="GrpcDotNetNamedPipes" Version="3.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
		<PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
		<PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
		<PackageReference Include="UACHelper" Version="1.3.0.5" />
		<PackageReference Include="WPF-UI" Version="4.0.0" />
		<PackageReference Include="WPF-UI.Tray" Version="4.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Winui3_Wpf_XamlNexus.DataAssistor\Winui3_Wpf_XamlNexus.DataAssistor.csproj" />
	  <!-- The WinUI project produces the UI plugin consumed by this host. -->
	  <ProjectReference Include="..\Winui3_Wpf_XamlNexus.UI\Winui3_Wpf_XamlNexus.UI.csproj"
	                    Condition="'$(PublishDesktopInstaller)' != 'true'"
	                    AdditionalProperties="Platform=x64"
	                    ReferenceOutputAssembly="false"
	                    SkipGetTargetFrameworkProperties="true"
	                    PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\lang.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>lang.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Properties\lang.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>lang.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Content Include="Nlog.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!--
		Evaluate the plugin files only after the WinUI dependency has built them.
		A static Content wildcard is evaluated too early on clean builds and races
		with the WinUI project's clean/build targets during parallel Rebuilds.
	-->
	<Target Name="CopyUiPluginToOutput" AfterTargets="Build">
		<ItemGroup>
			<UiPluginFile Include="$(MSBuildProjectDirectory)\Plugins\UI\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(UiPluginFile)"
		      DestinationFiles="@(UiPluginFile->'$(OutDir)Plugins\UI\%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="true" />
	</Target>

	<Target Name="CopyUiPluginToPublishDirectory"
	        AfterTargets="Publish"
	        Condition="'$(PublishDesktopInstaller)' == 'true'">
		<ItemGroup>
			<UiPluginPublishFile Include="$(MSBuildProjectDirectory)\Plugins\UI\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(UiPluginPublishFile)"
		      DestinationFiles="@(UiPluginPublishFile->'$(PublishDir)Plugins\UI\%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="true" />
	</Target>
</Project>
